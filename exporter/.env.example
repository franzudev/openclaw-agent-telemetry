# Bind address. Keep loopback unless Prometheus runs in another host/container
# (for Docker-Prometheus → host-exporter, bind 0.0.0.0 and firewall the port).
OBS_HOST=127.0.0.1
OBS_PORT=3220

# How many audit events to pull per refresh.
AUDIT_LIMIT=500

# Sessions considered "active" when joining audit events to run metadata (minutes).
ACTIVE_MINUTES=1440

# Audit/sessions poll interval; Prometheus scrapes a cached snapshot.
REFRESH_INTERVAL_MS=15000

# Set to 0 to drop the session message preview from failure labels.
INCLUDE_REASON_LABELS=1
