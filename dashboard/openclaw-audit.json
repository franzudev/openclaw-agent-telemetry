{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping the OpenClaw telemetry exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "row",
      "name": "Row",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": ">=10.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "id": null,
  "title": "OpenClaw Audit",
  "tags": [
    "openclaw",
    "audit",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 0,
      "title": "Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Total events",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(openclaw_audit_event_total)",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Succeeded",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(openclaw_audit_event_total{status=\"succeeded\"})",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Failed",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(openclaw_audit_event_total{status=\"failed\"})",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Failure rate %",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(openclaw_audit_event_total{status=\"failed\"}) / clamp_min(sum(openclaw_audit_event_total), 1)",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Last refresh",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "openclaw_collector_last_refresh_timestamp_seconds * 1000",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "id": 10,
      "title": "By model",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Requests by model and status",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "openclaw_audit_event_by_model_total",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "mergeSeries",
          "options": {},
          "topic": "in"
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "model": 0,
              "status": 1,
              "Value": 2
            },
            "renameByName": {
              "model": "Model",
              "status": "Status",
              "Value": "Count"
            },
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "node": true,
              "service": true,
              "__name__": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Failed by model",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (model) (openclaw_audit_event_by_model_total{status=\"failed\"})",
          "refId": "A",
          "legendFormat": "{{model}}",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "min": 0,
          "custom": {
            "axisPlacement": "auto"
          }
        }
      }
    },
    {
      "id": 20,
      "title": "Failures",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Recent failures",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "openclaw_audit_recent_failure_timestamp_ms",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "error_code": "Error",
              "tool": "Tool/Kind",
              "model": "Model",
              "run_id": "Run ID",
              "Value": "Time"
            },
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "node": true,
              "service": true,
              "__name__": true
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "time",
                "targetField": "Time"
              }
            ],
            "fields": {}
          }
        }
      ]
    },
    {
      "id": 22,
      "title": "Top error codes",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (error_code) (openclaw_audit_failed_by_error_total)",
          "refId": "A",
          "legendFormat": "{{error_code}}",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "min": 0
        }
      }
    },
    {
      "id": 30,
      "title": "Failed tools",
      "type": "bargauge",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (tool) (openclaw_audit_tool_failure_total)",
          "refId": "A",
          "legendFormat": "{{tool}}",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "min": 0
        }
      }
    },
    {
      "id": 31,
      "title": "Success vs failure by kind",
      "type": "barchart",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (kind, status) (openclaw_audit_event_by_kind_total)",
          "refId": "A",
          "legendFormat": "{{kind}} {{status}}",
          "editorMode": "code",
          "range": true,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto"
          }
        }
      }
    }
  ],
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "style": "dark",
  "templating": {
    "list": []
  }
}
